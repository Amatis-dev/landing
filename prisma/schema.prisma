generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Admin users (panel login) ----------

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
}

// ---------- Contact form submissions ----------

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([email])
}

// ---------- Blog posts ----------

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String
  content     String
  coverImage  String?
  tag         String?
  lang        String   @default("en")
  readMinutes Int      @default(5)
  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  groupId     String   @default("")

  @@index([published, publishedAt])
  @@index([groupId])
}

// ---------- Newsletter subscribers ----------

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// ---------- Site settings / editable content ----------
// Key-value store for editable page content (contact info, schedule panel)
// and credentials (SMTP, ...). Non-secret keys are exposed via /api/public/site-info.

model Setting {
  key       String   @id
  value     String
  isSecret  Boolean  @default(true)
  group     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([group])
}

// ---------- Meeting booking: concrete generated time slots ----------

model TimeSlot {
  id        String   @id @default(cuid())
  date      DateTime
  start     DateTime
  end       DateTime
  status    String   @default("available") // available | booked | blocked
  label     String?
  createdAt DateTime @default(now())

  booking   Booking?

  @@index([date])
  @@index([start, status])
}

// ---------- Meeting booking: confirmed bookings ----------

model Booking {
  id        String   @id @default(cuid())
  slotId    String   @unique
  name      String
  email     String
  notes     String?
  meetLink  String
  status    String   @default("confirmed") // confirmed | cancelled
  createdAt DateTime @default(now())

  slot      TimeSlot @relation(fields: [slotId], references: [id])

  @@index([createdAt])
  @@index([email])
}